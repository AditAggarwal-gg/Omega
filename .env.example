# Get these from Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-PUBLISHABLE-KEY   # new "publishable" key (sb_publishable_...), not anon legacy
# Only used server-side (Nitro routes), NEVER exposed to the client.
# Bypasses RLS — treat like a root password.
SUPABASE_SERVICE_KEY=YOUR-SECRET-KEY
